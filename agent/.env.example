# --- Discord ---
DISCORD_TOKEN=
# Ton identifiant Discord (mode développeur > clic droit sur ton profil >
# Copier l'identifiant). Seule frontière de sécurité de la commande !lier.
AGENT_ALLOWED_DISCORD_IDS=

# --- Supabase ---
SUPABASE_URL=https://teqsxzfslpxejncrkudz.supabase.co
SUPABASE_ANON_KEY=
# Sert UNIQUEMENT à résoudre l'identité et créer une session. Jamais aux données.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude Code ---
# Binaire authentifié une fois avec le compte Max : aucun token facturé en plus.
CLAUDE_BIN=claude
# Racine du dépôt Nysa sur le Pi5.
NYSA_REPO=/home/pi/nysa
CLAUDE_TIMEOUT_MS=180000
# Drapeaux additionnels si besoin, ex : --model claude-sonnet-5
CLAUDE_EXTRA_ARGS=

# --- Cerveau Obsidian ---
# Clone local du vault. Claude Code y accède avec ses outils de fichiers
# natifs : le markdown n'a besoin d'aucun MCP. Laisser vide pour désactiver.
OBSIDIAN_VAULT=/home/pi/cerveau

# --- Contrôle du Mac (SSH) ---
# Laisser vide pour désactiver entièrement. Ces tools ne sont chargés que dans
# les sessions où Nathan écrit lui-même — jamais dans le triage d'inbox, qui
# lit du contenu écrit par des tiers.
MAC_SSH_HOST=
MAC_SSH_USER=
MAC_SSH_KEY=/home/pi/.ssh/id_ed25519_mac

# --- Courrier (service nysa-mail) ---
# Les boîtes OVH suivies : marque=adresse, séparées par des virgules ; une
# marque peut en avoir plusieurs. Mot de passe par boîte : MAIL_PASS_<PARTIE_LOCALE>
# (contact@… → MAIL_PASS_CONTACT), à défaut MAIL_PASS_<MARQUE>.
# Hôte : MX Plan = ssl0.ovh.net · Email Pro = pro1.mail.ovh.net · Exchange = ex4.mail.ovh.net ;
# par boîte avec MAIL_HOST_<PARTIE_LOCALE>, par marque avec MAIL_HOST_<MARQUE>.
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=993
MAIL_ACCOUNTS=mixologue=nathan@exemple.com,aeterna=contact@exemple.be,aeterna=admin@exemple.be
MAIL_PASS_NATHAN=
MAIL_HOST_NATHAN=pro1.mail.ovh.net
MAIL_PASS_CONTACT=
MAIL_PASS_ADMIN=
# Au premier démarrage : combien de jours de courrier reprendre (0 = rien).
MAIL_BACKFILL_DAYS=1

# --- Notifications push (Web Push) ---
# Clés VAPID générées sur le Pi : `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# La publique va aussi dans app_config (key 'push') pour la PWA ; la privée reste ici.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.be
# Urgence maximale notifiée pour le courrier : 1 = urgents seulement, 3 = tout.
PUSH_MAX_URGENCY=3

# --- Triage des mails par Claude ---
# Alias Claude Code : sonnet (défaut), haiku, opus — ou off pour désactiver.
TRIAGE_MODEL=sonnet

# --- Divers ---
AGENT_TIMEZONE=Europe/Brussels
LOG_LEVEL=info

# Exiger une mention du bot en salon de serveur (inutile sur un serveur perso).
AGENT_REQUIRE_MENTION=false
