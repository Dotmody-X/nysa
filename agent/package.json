{
  "name": "nysa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Nysa : serveur MCP cloisonné par RLS + passerelle Discord vers Claude Code",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:bridge": "tsx watch src/discord/bridge.ts",
    "build": "tsc",
    "start:bridge": "node dist/discord/bridge.js",
    "start:mcp": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "start:mail": "node dist/mail/service.js",
    "dev:mail": "tsx watch src/mail/service.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
